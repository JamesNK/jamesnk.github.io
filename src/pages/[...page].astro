---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BlogPostContent from '../components/BlogPostContent.astro';
import Layout from '../layouts/Layout.astro';
import { getPostUrl } from '../consts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 4 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const postsWithContent = await Promise.all(
	page.data.map(async (post) => {
		const { Content } = await render(post);
		return { post, Content, url: getPostUrl(post) };
	})
);
---

<Layout>
	<style slot="head">
		.pagination {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			gap: 2rem;
			padding: 2rem;
			margin: 0 auto;
			font-size: 0.9em;
			font-family: sans-serif;
		}
		.pagination span.disabled {
			color: rgb(var(--gray-light));
			cursor: not-allowed;
		}
		.pagination .page-info {
			color: rgb(var(--gray));
		}
		.pagination .prev {
			justify-self: end;
		}
		.pagination .next {
			justify-self: start;
		}
	</style>
	{
		postsWithContent.map(({ post, Content, url }) => (
			<BlogPostContent post={post.data} url={url}>
				<Content />
			</BlogPostContent>
		))
	}
	<nav class="pagination">
		{page.url.prev ? (
			<a class="prev" href={page.url.prev}>← Previous</a>
		) : (
			<span class="disabled prev">← Previous</span>
		)}
		<span class="page-info">Page {page.currentPage} of {page.lastPage}</span>
		{page.url.next ? (
			<a class="next" href={page.url.next}>Next →</a>
		) : (
			<span class="disabled next">Next →</span>
		)}
	</nav>
</Layout>
</html>
