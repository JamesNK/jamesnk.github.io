---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BlogPostContent from '../../../components/BlogPostContent.astro';
import Layout from '../../../layouts/Layout.astro';
import { SITE_TITLE, getPostUrl } from '../../../consts';

export const getStaticPaths = (async () => {
	const posts = await getCollection('blog');
	
	// Group posts by year
	const postsByYear = posts.reduce((acc, post) => {
		const year = post.data.pubDate.getFullYear();
		if (!acc[year]) acc[year] = [];
		acc[year].push(post);
		return acc;
	}, {} as Record<number, typeof posts>);
	
	return Object.entries(postsByYear).map(([year, yearPosts]) => ({
		params: { year },
		props: { 
			year: parseInt(year),
			posts: yearPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		},
	}));
}) satisfies GetStaticPaths;

const { year, posts } = Astro.props;
---

<Layout title={`${year} Archive - ${SITE_TITLE}`}>
	<div class="archive archive-year">
		<div class="back-link">
			<a href="/archive/">&lt; All years</a>
		</div>
		<h1>{year}</h1>
		{posts.map((post) => (
			<BlogPostContent post={post.data} url={getPostUrl(post)}>
				{post.data.description && <p>{post.data.description}</p>}
			</BlogPostContent>
		))}
	</div>
</Layout>
