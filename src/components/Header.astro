---
import { SITE_TITLE, SITE_TITLE_SHORT } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">
				<svg viewBox="0 0 640 640" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M192 384L88.5 384C63.6 384 48.3 356.9 61.1 335.5L114 247.3C122.7 232.8 138.3 224 155.2 224L250.2 224C326.3 95.1 439.8 88.6 515.7 99.7C528.5 101.6 538.5 111.6 540.3 124.3C551.4 200.2 544.9 313.7 416 389.8L416 484.8C416 501.7 407.2 517.3 392.7 526L304.5 578.9C283.2 591.7 256 576.3 256 551.5L256 448C256 412.7 227.3 384 192 384L191.9 384zM464 224C464 197.5 442.5 176 416 176C389.5 176 368 197.5 368 224C368 250.5 389.5 272 416 272C442.5 272 464 250.5 464 224z"
					></path></svg
				>
				<span class="site-title">{SITE_TITLE}</span>
				<span class="site-title-short">{SITE_TITLE_SHORT}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/" isActiveFn={(p) => p.startsWith('archive') || /^\d+\/?$/.test(p)}>Blog</HeaderLink>
			<HeaderLink href="/bio">Bio</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://twitter.com/jamesnk" target="_blank">
				<span class="sr-only">Follow JamesNK on Twitter</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
					></path></svg
				>
			</a>
			<a href="https://github.com/jamesnk" target="_blank">
				<span class="sr-only">Go to JamesNK's GitHub repo</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background-color: #1B1B1B;
		background-image: linear-gradient(to bottom, #222222, #111111);
		background-repeat: repeat-x;
		border-top: 3px solid #CC0001;
		border-bottom-width: 0;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	nav h2 a,
	nav h2 a.active {
		display: inline-flex;
		align-items: center;
		gap: 0.2em;
		line-height: normal;
		color: #B3DF00;
	}
	nav h2 a:hover {
		color: #FFFFFF;
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: #999999;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a:hover {
		color: #acacac;
	}
	nav a.active {
		color: #FFFFFF;
		border-bottom-color: #41ABE1;
	}
	.social-links {
		display: flex;
		justify-self: end;
	}
	.social-links a {
		display: flex;
		color: #666666;
	}
	.social-links a:hover {
		color: #999999;
	}
	.site-title-short {
		display: none;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.site-title {
			display: none;
		}
		.site-title-short {
			display: inline;
		}
	}
</style>
